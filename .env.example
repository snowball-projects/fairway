# Copy this file to .env and add the fairway-specific TomTom key.
TOMTOM_API_KEY=
# With a key, TomTom is selected automatically. Set static for local-only routing.
# FAIRWAY_MATRIX_PROVIDER=static
# Conservative submitted-cell guard per process and UTC day. Set 0 to pause.
FAIRWAY_TOMTOM_DAILY_CELLS=80
# Private national prototype operator settings; never browser inputs.
# Defaults to loopback:8081 with a loopback router:8003. No credentials required.
# FAIRWAY_NATIONAL_ROUTER=http://127.0.0.1:8003
# FAIRWAY_NATIONAL_BIND=127.0.0.1
# FAIRWAY_NATIONAL_DATASET=us-261011-operator-declared
